<Window x:Class="VOIDOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VOIDOverlay.Controls"
        Title="VOID Overlay Termo"
        Icon="pack://application:,,,/assets/void-overlay.ico"
        Height="62"
        SizeToContent="Width"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseRightButtonDown="Window_MouseRightButtonDown">

    <Border x:Name="OverlaySurface"
            Height="44"
            Background="Transparent"
            CornerRadius="5"
            Padding="10,4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
    <Grid Height="36" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="18" />
            <RowDefinition Height="18" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <controls:TemperatureHistoryChart x:Name="CpuChart" Grid.Column="0"
                                             Width="132"
                                             Height="13"
                                             Series="{Binding CpuHistory}"
                                             StrokeBrush="#4DE3D2"
                                             Margin="0,0,8,0" />

            <TextBlock x:Name="CpuTemperatureTextBlock"
                       Grid.Column="1"
                       Text="{Binding CpuTemperatureText}"
                       Foreground="#4DE3D2"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       AutomationProperties.Name="CPU temperature" />
        </Grid>

        <Grid Grid.Row="1" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <controls:TemperatureHistoryChart x:Name="GpuChart" Grid.Column="0"
                                             Width="132"
                                             Height="13"
                                             Series="{Binding GpuHistory}"
                                             StrokeBrush="#FFAE5C"
                                             Margin="0,0,8,0" />

            <TextBlock x:Name="GpuTemperatureTextBlock"
                       Grid.Column="1"
                       Text="{Binding GpuTemperatureText}"
                       Foreground="#FFAE5C"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       AutomationProperties.Name="GPU temperature" />
        </Grid>
    </Grid>
    </Border>
</Window>
