<Window x:Class="VOIDOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VOIDOverlay.Controls"
        Title="VOID Overlay Termo"
        Icon="pack://application:,,,/assets/void-overlay.ico"
        Width="280"
        Height="62"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseRightButtonDown="Window_MouseRightButtonDown">

    <Border x:Name="OverlaySurface"
            Width="260"
            Height="44"
            Background="#80111720"
            CornerRadius="5"
            Padding="10,4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
    <Grid Width="240" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="18" />
            <RowDefinition Height="18" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Width="240" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="132" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="CpuLabel" Grid.Column="0" Text="CPU" Foreground="#F2F4F7"
                       FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
            <controls:TemperatureHistoryChart x:Name="CpuChart" Grid.Column="1"
                                             Width="132"
                                             Height="13"
                                             Series="{Binding CpuHistory}"
                                             StrokeBrush="#4DE3D2" />

            <TextBlock x:Name="CpuTemperatureTextBlock"
                       Grid.Column="2"
                       Text="{Binding CpuTemperatureText}"
                       Width="80"
                       Foreground="#4DE3D2"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left" />
        </Grid>

        <Grid Grid.Row="1" Width="240" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="132" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="GpuLabel" Grid.Column="0" Text="GPU" Foreground="#F2F4F7"
                       FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
            <controls:TemperatureHistoryChart x:Name="GpuChart" Grid.Column="1"
                                             Width="132"
                                             Height="13"
                                             Series="{Binding GpuHistory}"
                                             StrokeBrush="#FFAE5C" />

            <TextBlock x:Name="GpuTemperatureTextBlock"
                       Grid.Column="2"
                       Text="{Binding GpuTemperatureText}"
                       Width="80"
                       Foreground="#FFAE5C"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left" />
        </Grid>
    </Grid>
    </Border>
</Window>
