<Window x:Class="VOIDOverlay.OverlaySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Termo Settings"
        Icon="pack://application:,,,/assets/void-overlay.ico"
        Width="380"
        Height="460"
        MinWidth="320"
        MinHeight="280"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">
            <StackPanel>
                <TextBlock Text="Position" Margin="0,0,0,4" />
                <ComboBox x:Name="PositionComboBox" Margin="0,0,0,12" />

                <TextBlock Text="Position Fine-Tuning" Margin="0,0,0,6" FontWeight="SemiBold" />

                <TextBlock Text="Horizontal Offset (X) — DIPs" Margin="0,0,0,3" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="HorizontalOffsetSlider"
                            Minimum="-200" Maximum="1000" Value="0"
                            ValueChanged="OffsetSlider_ValueChanged"
                            VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="HorizontalOffsetTextBox"
                             Grid.Column="1" Width="64" VerticalContentAlignment="Center"
                             TextChanged="OffsetTextBox_TextChanged"
                             LostFocus="OffsetTextBox_LostFocus" />
                </Grid>

                <TextBlock Text="Vertical Offset (Y) — DIPs" Margin="0,0,0,3" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="VerticalOffsetSlider"
                            Minimum="-200" Maximum="1000" Value="0"
                            ValueChanged="OffsetSlider_ValueChanged"
                            VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="VerticalOffsetTextBox"
                             Grid.Column="1" Width="64" VerticalContentAlignment="Center"
                             TextChanged="OffsetTextBox_TextChanged"
                             LostFocus="OffsetTextBox_LostFocus" />
                </Grid>

                <TextBlock Text="Edge Reference" Margin="0,0,0,4" />
                <ComboBox x:Name="EdgeReferenceComboBox" Margin="0,0,0,12"
                          SelectionChanged="EdgeReferenceComboBox_SelectionChanged">
                    <ComboBoxItem Content="Full Screen" Tag="FullScreen" />
                    <ComboBoxItem Content="Work Area" Tag="WorkArea" />
                </ComboBox>
                <TextBlock Text="Offsets are not clamped. Negative values move past the selected edge; large positive values may extend past the opposite edge."
                           TextWrapping="Wrap" FontSize="11" Opacity="0.75" Margin="0,0,0,12" />

                <TextBlock Text="Sampling interval (ms)" Margin="0,0,0,4" />
                <Slider x:Name="RefreshIntervalSlider" Minimum="250" Maximum="5000" TickFrequency="250"
                        IsSnapToTickEnabled="True" Value="1000" Margin="0,0,0,12" />

                <CheckBox x:Name="LockCheckBox" Content="Overlay locked" Margin="0,0,0,6" />
                <CheckBox x:Name="ClickThroughCheckBox" Content="Click-through enabled" Margin="0,0,0,6" />
                <CheckBox x:Name="StartupCheckBox" Content="Start with Windows" Margin="0,0,0,8" />
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1"
                Content="Save"
                Width="80"
                HorizontalAlignment="Right"
                Margin="0,10,0,0"
                Click="SaveButton_Click" />
    </Grid>
</Window>
